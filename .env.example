# ─────────────────────────────────────────────────────────────────
#  Bifröst — environment configuration
#  Copy to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────

# ── Active selection ─────────────────────────────────────────────
# Which environment + role the server boots with by default.
# Both can be overridden per-request from MCP tool call context.
GRAFANA_MCP_ACTIVE_ENVIRONMENT=dev
GRAFANA_MCP_ACTIVE_ROLE=viewer

# ── Transport ────────────────────────────────────────────────────
# mode: "sse" for VSCode + browser UI, "http" for SDK + CI
GRAFANA_MCP_TRANSPORT__MODE=sse
GRAFANA_MCP_TRANSPORT__HOST=0.0.0.0
GRAFANA_MCP_TRANSPORT__PORT=8765
GRAFANA_MCP_TRANSPORT__PATH_PREFIX=/mcp

# ── Logging ──────────────────────────────────────────────────────
GRAFANA_MCP_LOG_LEVEL=INFO
# Use "json" for production, "console" for dev
GRAFANA_MCP_LOG_FORMAT=console

# ─────────────────────────────────────────────────────────────────
#  dev environment
# ─────────────────────────────────────────────────────────────────
GRAFANA_MCP_ENVIRONMENTS__DEV__BASE_URL=http://localhost:3000
GRAFANA_MCP_ENVIRONMENTS__DEV__TLS_VERIFY=false
GRAFANA_MCP_ENVIRONMENTS__DEV__TIMEOUT_SECONDS=30
GRAFANA_MCP_ENVIRONMENTS__DEV__RATE_LIMIT_RPS=20

GRAFANA_MCP_ENVIRONMENTS__DEV__SERVICE_ACCOUNTS__VIEWER=glsa_dev_viewer_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__DEV__SERVICE_ACCOUNTS__EDITOR=glsa_dev_editor_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__DEV__SERVICE_ACCOUNTS__ADMIN=glsa_dev_admin_xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
#  perf environment
# ─────────────────────────────────────────────────────────────────
GRAFANA_MCP_ENVIRONMENTS__PERF__BASE_URL=https://grafana-perf.company.com
GRAFANA_MCP_ENVIRONMENTS__PERF__TLS_VERIFY=true
GRAFANA_MCP_ENVIRONMENTS__PERF__TIMEOUT_SECONDS=30
GRAFANA_MCP_ENVIRONMENTS__PERF__RATE_LIMIT_RPS=10

GRAFANA_MCP_ENVIRONMENTS__PERF__SERVICE_ACCOUNTS__VIEWER=glsa_perf_viewer_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__PERF__SERVICE_ACCOUNTS__EDITOR=glsa_perf_editor_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__PERF__SERVICE_ACCOUNTS__ADMIN=glsa_perf_admin_xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
#  prod environment
# ─────────────────────────────────────────────────────────────────
GRAFANA_MCP_ENVIRONMENTS__PROD__BASE_URL=https://grafana.company.com
GRAFANA_MCP_ENVIRONMENTS__PROD__TLS_VERIFY=true
GRAFANA_MCP_ENVIRONMENTS__PROD__TIMEOUT_SECONDS=30
GRAFANA_MCP_ENVIRONMENTS__PROD__RATE_LIMIT_RPS=10

GRAFANA_MCP_ENVIRONMENTS__PROD__SERVICE_ACCOUNTS__VIEWER=glsa_prod_viewer_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__PROD__SERVICE_ACCOUNTS__EDITOR=glsa_prod_editor_xxxxxxxxxxxxxxxx
GRAFANA_MCP_ENVIRONMENTS__PROD__SERVICE_ACCOUNTS__ADMIN=glsa_prod_admin_xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────
#  Corporate proxy (optional — uncomment if needed)
# ─────────────────────────────────────────────────────────────────
# HTTP_PROXY=http://proxy.corp.example.com:8080
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# NO_PROXY=localhost,127.0.0.1
